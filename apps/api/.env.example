DATABASE_URL="postgresql://kruze:kruze@localhost:5432/kruze?schema=public"
JWT_ACCESS_SECRET="change-me-in-every-environment"
JWT_ACCESS_TTL="15m"
PORT=3000
# Comma-separated Kafka broker list — see src/eventbus/README.md for
# how to run one locally. Optional: the app boots and works fine with
# no broker reachable, it just won't publish/consume domain events.
KAFKA_BROKERS="localhost:9092"
