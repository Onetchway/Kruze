{
  "name": "kruze",
  "private": true,
  "version": "0.1.0",
  "description": "Kruze Enterprise Employee Mobility & Fleet Operating System",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "api:dev": "pnpm --filter @kruze/api start:dev",
    "api:test": "pnpm --filter @kruze/api test",
    "api:test:e2e": "pnpm --filter @kruze/api test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "js-yaml": "^4.3.1"
    }
  }
}
